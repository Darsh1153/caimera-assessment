PORT=8080
# Comma-separated browser origins allowed for CORS (include your frontend URL on Heroku).
CLIENT_ORIGIN=http://localhost:5173

REDIS_URL=redis://localhost:6379

# Local Postgres (ignored when DATABASE_URL is set — Heroku sets DATABASE_URL automatically).
PGHOST=localhost
PGPORT=55432
PGUSER=quiz
PGPASSWORD=quiz
PGDATABASE=quiz

ADMIN_TOKEN=change-me
